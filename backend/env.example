# ============================================
# ENVIRONMENT CONFIGURATION
# ============================================
# Copy this file to .env and fill in your values

# Environment
NODE_ENV=development
APP_ENV=local
PORT=3000

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/ai_identity

# Session Secret (generate a random string)
SESSION_SECRET=your-session-secret-here-change-in-production

# OpenAI API (for fallback)
OPENAI_API_KEY=sk-your-openai-api-key

# Groq API
GROQ_API_KEY=your-groq-api-key
GROQ_API_KEY_ANONYMOUS=your-groq-api-key-anonymous

# ElevenLabs Voice Cloning API
ELEVENLABS_API_KEY=your-elevenlabs-api-key

# Frontend URL (required in production)
FRONTEND_URL=http://localhost:3000

# Google OAuth (optional)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Email Configuration (optional)
MAIL_FROM=noreply@yourdomain.com
SUPPORT_EMAIL=support@yourdomain.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Security
JWT_SECRET=your-jwt-secret-change-in-production
ID_TOKEN_SECRET=your-id-token-secret-change-in-production
IP_HASH_SECRET=your-ip-hash-secret-change-in-production

# Feature Flags
FORCE_INSECURE_COOKIES=false

# ===== S3 / R2 Storage (Phase 1) =====
S3_BUCKET=your-bucket
S3_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your-key
AWS_SECRET_ACCESS_KEY=your-secret

# Optional (Cloudflare R2 / any S3-compatible)
S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
S3_FORCE_PATH_STYLE=true
# Public base URL for serving uploaded files (RECOMMENDED for R2)
S3_PUBLIC_BASE_URL=https://your-public-domain-or-r2dev

# ===== Twilio WhatsApp (Phase 1 Week 3) =====
TWILIO_ACCOUNT_SID=ACxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxx
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# ===== Meta / Instagram (Phase 1 Week 2) =====
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_VERIFY_TOKEN=some-random-verify-token-for-webhook-verification

# ===== Stripe (Phase 1 monetization) =====
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Subscription price IDs (Stripe dashboard se)
STRIPE_PRICE_STARTER=price_xxx
STRIPE_PRICE_GROWTH=price_xxx
STRIPE_PRICE_SCALE=price_xxx

