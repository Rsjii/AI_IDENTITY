# ============================================
# ENVIRONMENT CONFIGURATION
# ============================================
# Copy this file to .env and fill in your values

# Environment
NODE_ENV=development
APP_ENV=local
PORT=3000

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/ai_identity

# Session Secret (generate a random string)
SESSION_SECRET=your-session-secret-here-change-in-production

# OpenAI API (for fallback)
OPENAI_API_KEY=sk-your-openai-api-key

# Groq API
GROQ_API_KEY=your-groq-api-key
GROQ_API_KEY_ANONYMOUS=your-groq-api-key-anonymous

# ElevenLabs Voice Cloning API
ELEVENLABS_API_KEY=your-elevenlabs-api-key

# Frontend URL (required in production)
FRONTEND_URL=http://localhost:3000

# Google OAuth (optional)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Email Configuration (optional)
MAIL_FROM=noreply@yourdomain.com
SUPPORT_EMAIL=support@yourdomain.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Security
ID_TOKEN_SECRET=your-id-token-secret-change-in-production
IP_HASH_SECRET=your-ip-hash-secret-change-in-production

# Feature Flags
FORCE_INSECURE_COOKIES=false

