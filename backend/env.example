# ============================================
# ENVIRONMENT CONFIGURATION
# ============================================
# Copy this file to .env and fill in your values

# Environment
NODE_ENV=development
APP_ENV=local
PORT=3000

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/ai_identity

# Optional: separate DB URL for admin analytics (defaults to DATABASE_URL)
ADMIN_ANALYTICS_DB_URL=postgresql://user:password@localhost:5432/ai_identity

# Session Secret (generate a random string)
SESSION_SECRET=your-session-secret-here-change-in-production

# OpenAI API (for fallback)
OPENAI_API_KEY=sk-your-openai-api-key

# Groq API
GROQ_API_KEY=your-groq-api-key
GROQ_API_KEY_ANONYMOUS=your-groq-api-key-anonymous

# ElevenLabs Voice Cloning API
ELEVENLABS_API_KEY=your-elevenlabs-api-key

# Frontend URL (required in production; used for redirects + emails)
FRONTEND_URL=http://localhost:5173
# Optional explicit app url used in emails (falls back to FRONTEND_URL)
APP_URL=http://localhost:5173

# Google OAuth (optional)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Email Configuration (optional)
MAIL_FROM=noreply@yourdomain.com
SUPPORT_EMAIL=support@yourdomain.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Security
JWT_SECRET=your-jwt-secret-change-in-production
JWT_REFRESH_SECRET=your-jwt-refresh-secret-change-in-production
ID_TOKEN_SECRET=your-id-token-secret-change-in-production
IP_HASH_SECRET=your-ip-hash-secret-change-in-production

# Admin access (comma separated emails)
ADMIN_EMAILS=admin@yourdomain.com,another_admin@yourdomain.com

# Feature Flags
FORCE_INSECURE_COOKIES=false
LOG_ENV_CONFIG=false
DEBUG_MODE=false
VALIDATION_MODE=true
ENABLE_AI_GENERATION=true
ENABLE_ANALYTICS=true
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_RATE_LIMITING=true

# Phase 1 features (subscription + widget + pay-per-chat)
ENABLE_PAYMENTS=true
ENABLE_WIDGET=true
ENABLE_PAY_PER_CHAT=true

# Phase 2/3 module flags (OFF by default for Phase 1)
ENABLE_MARKETPLACE=false
ENABLE_VOICE=false
ENABLE_VIDEO=false
ENABLE_PHONE=false
ENABLE_WHATSAPP=false
ENABLE_INSTAGRAM=false

# Social Media API Keys (for content import)
YOUTUBE_API_KEY=your-youtube-data-api-v3-key
TWITTER_BEARER_TOKEN=your-twitter-api-v2-bearer-token

# Twitter OAuth (for social import)
TWITTER_CLIENT_ID=your_twitter_client_id
TWITTER_CLIENT_SECRET=your_twitter_client_secret
TWITTER_CALLBACK_URL=http://localhost:3000/api/content/social/twitter/callback

# ===== S3 / R2 Storage (Phase 1) =====
S3_BUCKET=your-bucket
S3_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your-key
AWS_SECRET_ACCESS_KEY=your-secret

# Optional (Cloudflare R2 / any S3-compatible)
S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
S3_FORCE_PATH_STYLE=true
# Public base URL for serving uploaded files (RECOMMENDED for R2)
S3_PUBLIC_BASE_URL=https://your-public-domain-or-r2dev

# Local uploads directory (optional)
UPLOADS_DIR=./public/uploads

# CORS for widget embed (comma-separated; leave empty to allow all origins for /api/widget)
CORS_ALLOWED_ORIGINS=
CORS_ALLOW_CREDENTIALS=false

# Rate limiting (in ms / per window)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=10000000

# ===== Twilio WhatsApp (Phase 1 Week 3) =====
TWILIO_ACCOUNT_SID=ACxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxx
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# ===== Twilio Voice (Phase 3 Phone Integration) =====
# Reuses TWILIO_ACCOUNT_SID / TWILIO_AUTH_TOKEN
# Your purchased Twilio Voice number in E.164 (optional; depends on your Twilio setup)
TWILIO_VOICE_NUMBER=+15550123

# ===== Meta / Instagram (Phase 1 Week 2) =====
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_VERIFY_TOKEN=some-random-verify-token-for-webhook-verification

# ===== Razorpay (India - platform plan checkout) =====
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=xxx

# India plan pricing (PAISE). You can change these.
# Example: ₹999 = 99900
RAZORPAY_PRICE_STARTER_PAISE=99900
RAZORPAY_PRICE_GROWTH_PAISE=199900
RAZORPAY_PRICE_SCALE_PAISE=499900

# ===== LemonSqueezy (International - platform plan checkout) =====
LEMONSQUEEZY_API_KEY=your_lemon_squeezy_api_key
LEMONSQUEEZY_STORE_ID=your_lemon_squeezy_store_id
LEMONSQUEEZY_WEBHOOK_SECRET=your_lemon_squeezy_webhook_secret

# Subscription variant IDs (from LemonSqueezy dashboard)
LEMONSQUEEZY_VARIANT_ID_STARTER=variant_id_for_starter
LEMONSQUEEZY_VARIANT_ID_GROWTH=variant_id_for_growth
LEMONSQUEEZY_VARIANT_ID_SCALE=variant_id_for_scale

# ===== Video Avatar Provider (Phase 3) =====
# Current implementation reads DID_API_KEY (D-ID). Keep HEYGEN_API_KEY as optional for future provider switch.
DID_API_KEY=did_api_key_here
HEYGEN_API_KEY=heygen_api_key_here

# ===== Error Monitoring =====
SENTRY_DSN=

