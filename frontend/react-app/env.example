# ============================================
# FRONTEND (VITE) ENVIRONMENT CONFIGURATION
# ============================================
# Copy this file to .env (same folder) and fill in your values.
#
# NOTE:
# - Only variables prefixed with VITE_ are exposed to the browser.
# - Never put secret keys here.

# Base URL for backend API (optional).
# Leave empty to use relative URLs (works when frontend is served behind same origin/proxy).
VITE_API_BASE_URL=

# Stripe publishable key (required for Pay‑Per‑Chat UI)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Meta App ID (optional; used to build Instagram OAuth URL in Integrations UI)
VITE_META_APP_ID=1234567890

# Frontend error monitoring (optional)
# Set VITE_ENABLE_SENTRY=true AND provide a valid DSN to enable Sentry
VITE_ENABLE_SENTRY=false
VITE_SENTRY_DSN=

# Feature Flags (Phase 1 defaults)
# Phase 1 features (ON by default)
VITE_ENABLE_WIDGET=true
VITE_ENABLE_PAY_PER_CHAT=true

# Phase 2/3 features (OFF by default for Phase 1)
VITE_ENABLE_VOICE=false
VITE_ENABLE_MARKETPLACE=false
VITE_ENABLE_VIDEO=false
VITE_ENABLE_PHONE=false
VITE_ENABLE_WHATSAPP=false
VITE_ENABLE_INSTAGRAM=false


