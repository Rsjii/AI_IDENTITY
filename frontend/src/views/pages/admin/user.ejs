<%- include('../../shared/layout', { title, user, csrfToken, body: `
    <div class="space-y-6">
      <div class="flex items-start justify-between gap-4">
        <div>
          <h1 class="text-2xl sm:text-3xl font-bold text-gray-900 dark:text-white">Admin — User</h1>
          <p class="text-sm text-gray-600 dark:text-gray-300">User detail + identity + runs + events.</p>
        </div>
        <a href="/admin" class="px-4 py-2 rounded-xl bg-white/60 dark:bg-white/5 border border-white/20 dark:border-white/10 text-sm">← Back</a>
      </div>
    
      <div id="userCard" class="p-5 rounded-2xl bg-white/60 dark:bg-white/5 border border-white/20 dark:border-white/10">Loading…</div>
    
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
        <div class="overflow-hidden rounded-2xl border border-white/20 dark:border-white/10 bg-white/60 dark:bg-white/5 backdrop-blur-xl">
          <div class="p-4 font-semibold text-gray-900 dark:text-white">Recent Mirror Runs</div>
          <div class="overflow-x-auto">
            <table class="min-w-full text-sm">
              <thead class="text-left text-gray-600 dark:text-gray-300">
                <tr><th class="p-4">Time</th><th class="p-4">Context</th><th class="p-4">Decision</th><th class="p-4">Tokens</th></tr>
              </thead>
              <tbody id="runs" class="divide-y divide-white/10"></tbody>
            </table>
          </div>
        </div>
    
        <div class="overflow-hidden rounded-2xl border border-white/20 dark:border-white/10 bg-white/60 dark:bg-white/5 backdrop-blur-xl">
          <div class="p-4 font-semibold text-gray-900 dark:text-white">Recent Events</div>
          <div class="overflow-x-auto">
            <table class="min-w-full text-sm">
              <thead class="text-left text-gray-600 dark:text-gray-300">
                <tr><th class="p-4">Time</th><th class="p-4">Type</th><th class="p-4">Meta</th></tr>
              </thead>
              <tbody id="events" class="divide-y divide-white/10"></tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
    
    <script>
      const USER_ID = "<%= userId %>";
      function esc(s){ return String(s||'').replace(/[&<>"']/g, c=>({ '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;' }[c])); }
    
      async function load() {
        const res = await fetch('/api/admin/users/' + encodeURIComponent(USER_ID));
        const j = await res.json();
        const d = j.data || {};
        const u = d.user || {};
        const ident = d.identity || null;
    
        const created = u.createdAt ? (window.TimeUtils ? TimeUtils.formatLocalDateTime(u.createdAt) : new Date(u.createdAt).toLocaleString()) : '—';
        document.getElementById('userCard').innerHTML =
          '<div class="text-gray-900 dark:text-white font-semibold">' + esc(u.email || USER_ID) + '</div>' +
          '<div class="text-sm text-gray-600 dark:text-gray-300 mt-1">Handle: ' + esc(u.handle || '—') + ' · Name: ' + esc(u.name || '—') + '</div>' +
          '<div class="text-sm text-gray-600 dark:text-gray-300 mt-1">Created: ' + esc(created) + ' · Profile: ' + esc(u.profileCompleted ? '✅' : '—') + ' · TZ: ' + esc(u.timeZone || '—') + '</div>' +
          '<div class="text-sm text-gray-600 dark:text-gray-300 mt-3">Has identity: ' + esc(ident ? '✅' : '—') + (ident ? (' · Active version: ' + esc(ident.activeVersion || '—')) : '') + '</div>';
    
        // Runs
        const runs = d.runs || [];
        const runsTbody = document.getElementById('runs');
        runsTbody.innerHTML = runs.length ? runs.map(r => {
          const when = window.TimeUtils ? TimeUtils.formatRelativeTime(r.createdAt) : new Date(r.createdAt).toLocaleString();
          const whenFull = window.TimeUtils ? TimeUtils.formatLocalDateTime(r.createdAt) : new Date(r.createdAt).toLocaleString();
          const decision = r.confirmEvent === 'confirm_yes' ? '✅' : (r.confirmEvent === 'confirm_no' ? '❌' : '—');
          const tokens = (Number(r.tokensIn||0) + Number(r.tokensOut||0));
          return '<tr class="text-gray-900 dark:text-white">' +
            '<td class="p-4" title="'+esc(whenFull)+'">'+esc(when)+'</td>' +
            '<td class="p-4">'+esc(r.context)+'</td>' +
            '<td class="p-4">'+esc(decision)+'</td>' +
            '<td class="p-4">'+esc(tokens)+'</td>' +
          '</tr>';
        }).join('') : '<tr><td class="p-4 text-gray-600 dark:text-gray-300" colspan="4">No runs</td></tr>';
    
        // Events
        const events = d.events || [];
        const evTbody = document.getElementById('events');
        evTbody.innerHTML = events.length ? events.map(e => {
          const when = window.TimeUtils ? TimeUtils.formatRelativeTime(e.createdAt) : new Date(e.createdAt).toLocaleString();
          const whenFull = window.TimeUtils ? TimeUtils.formatLocalDateTime(e.createdAt) : new Date(e.createdAt).toLocaleString();
          const meta = e.meta ? JSON.stringify(e.meta) : '';
          return '<tr class="text-gray-900 dark:text-white">' +
            '<td class="p-4" title="'+esc(whenFull)+'">'+esc(when)+'</td>' +
            '<td class="p-4">'+esc(e.type)+'</td>' +
            '<td class="p-4 text-xs text-gray-600 dark:text-gray-300 break-all">'+esc(meta)+'</td>' +
          '</tr>';
        }).join('') : '<tr><td class="p-4 text-gray-600 dark:text-gray-300" colspan="3">No events</td></tr>';
      }
    
      load();
    </script>
    ` }) %>

