<%- include('../shared/layout', { title, user, csrfToken, body: `
    <div class="max-w-4xl mx-auto space-y-6">
      <h1 class="text-3xl font-bold text-gray-900 dark:text-white">File Management</h1>

      <!-- Storage Overview -->
      <div id="storage-overview" class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg p-6 shadow-sm">
        <div class="flex items-center justify-between mb-3">
          <h3 class="font-semibold text-lg text-gray-900 dark:text-white">Storage Usage</h3>
          <span id="storage-text" class="text-sm text-gray-600 dark:text-gray-400">Loading...</span>
        </div>

        <!-- Progress Bar -->
        <div class="bg-gray-200 dark:bg-gray-700 rounded-full h-3 mb-3">
          <div id="storage-bar" class="h-3 rounded-full transition-all bg-blue-500" style="width: 0%"></div>
        </div>

        <!-- Plan Info -->
        <div class="flex items-center justify-between text-sm">
          <span class="text-gray-600 dark:text-gray-400">
            Plan: <span id="plan-tier" class="font-medium capitalize">-</span>
          </span>
          <span id="remaining-text" class="text-gray-600 dark:text-gray-400">-</span>
        </div>

        <!-- Warning Messages -->
        <div id="storage-warning" class="mt-4 hidden"></div>
      </div>

      <!-- File List -->
      <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg shadow-sm">
        <div class="px-6 py-4 border-b border-gray-200 dark:border-gray-700">
          <h3 class="font-semibold text-lg text-gray-900 dark:text-white">
            Your Files (<span id="file-count">0</span>)
          </h3>
        </div>

        <div class="p-6">
          <div id="files-container">
            <div class="text-center py-12">
              <p class="text-gray-500 dark:text-gray-400">Loading files...</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Help Text -->
      <div class="bg-blue-50 dark:bg-blue-900/20 border border-blue-200 dark:border-blue-800 rounded-lg p-4">
        <p class="text-sm text-blue-900 dark:text-blue-100">
          <strong>💡 Tip:</strong> Upload files through the Voice and Video sections.
          Files are automatically tracked against your storage quota.
        </p>
      </div>
    </div>

    <script>
      let storageData = null;
      let filesData = [];

      // Fetch storage usage
      async function fetchStorageUsage() {
        try {
          const response = await fetch('/api/creator/storage', {
            credentials: 'include'
          });

          if (!response.ok) {
            throw new Error('Failed to fetch storage');
          }

          const data = await response.json();
          storageData = data;
          renderStorageUsage();
        } catch (error) {
          console.error('Storage fetch error:', error);
        }
      }

      // Fetch files
      async function fetchFiles() {
        try {
          const response = await fetch('/api/creator/files', {
            credentials: 'include'
          });

          if (!response.ok) {
            throw new Error('Failed to fetch files');
          }

          const data = await response.json();
          filesData = data.files || [];
          renderFiles();
        } catch (error) {
          console.error('Files fetch error:', error);
          document.getElementById('files-container').innerHTML = \`
            <div class="text-center py-8 text-red-600 dark:text-red-400">
              Failed to load files. Please refresh the page.
            </div>
          \`;
        }
      }

      // Render storage usage
      function renderStorageUsage() {
        if (!storageData) return;

        const { planTier, quotaMB, usedMB, remainingMB, percentageUsed } = storageData;

        document.getElementById('storage-text').textContent = \`\${usedMB.toFixed(2)} / \${quotaMB} MB\`;
        document.getElementById('plan-tier').textContent = planTier;
        document.getElementById('remaining-text').textContent = \`\${remainingMB.toFixed(2)} MB remaining\`;

        const storageBar = document.getElementById('storage-bar');
        const clampedPercentage = Math.min(percentageUsed, 100);
        storageBar.style.width = \`\${clampedPercentage}%\`;

        // Set color based on percentage
        if (percentageUsed >= 90) {
          storageBar.classList.remove('bg-blue-500', 'bg-yellow-500');
          storageBar.classList.add('bg-red-500');
        } else if (percentageUsed >= 80) {
          storageBar.classList.remove('bg-blue-500', 'bg-red-500');
          storageBar.classList.add('bg-yellow-500');
        } else {
          storageBar.classList.remove('bg-red-500', 'bg-yellow-500');
          storageBar.classList.add('bg-blue-500');
        }

        // Show warnings
        const warningEl = document.getElementById('storage-warning');
        if (percentageUsed >= 100) {
          warningEl.className = 'mt-4 bg-red-50 dark:bg-red-900/20 border-l-4 border-red-400 p-3 rounded';
          warningEl.innerHTML = \`
            <div class="flex items-start gap-2">
              <svg class="w-4 h-4 text-red-600 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
              </svg>
              <div>
                <p class="text-sm text-red-800 dark:text-red-200 font-medium">Storage full</p>
                <p class="text-xs text-red-700 dark:text-red-300 mt-1">Cannot upload new files. Delete files before uploading.</p>
              </div>
            </div>
          \`;
        } else if (percentageUsed >= 90) {
          warningEl.className = 'mt-4 bg-red-50 dark:bg-red-900/20 border-l-4 border-red-400 p-3 rounded';
          warningEl.innerHTML = \`
            <div class="flex items-start gap-2">
              <svg class="w-4 h-4 text-red-600 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
              </svg>
              <div>
                <p class="text-sm text-red-800 dark:text-red-200 font-medium">Storage almost full</p>
                <p class="text-xs text-red-700 dark:text-red-300 mt-1">Delete unused files or upgrade your plan to avoid upload failures.</p>
              </div>
            </div>
          \`;
        } else if (percentageUsed >= 80) {
          warningEl.className = 'mt-4 bg-yellow-50 dark:bg-yellow-900/20 border-l-4 border-yellow-400 p-3 rounded';
          warningEl.innerHTML = \`
            <div class="flex items-start gap-2">
              <svg class="w-4 h-4 text-yellow-600 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
              </svg>
              <div>
                <p class="text-sm text-yellow-800 dark:text-yellow-200 font-medium">Storage running low</p>
                <p class="text-xs text-yellow-700 dark:text-yellow-300 mt-1">Consider deleting old files or upgrading your plan.</p>
              </div>
            </div>
          \`;
        } else {
          warningEl.className = 'mt-4 hidden';
        }
      }

      // Render files
      function renderFiles() {
        const container = document.getElementById('files-container');
        const countEl = document.getElementById('file-count');

        countEl.textContent = filesData.length;

        if (filesData.length === 0) {
          container.innerHTML = \`
            <div class="text-center py-12">
              <svg class="w-12 h-12 text-gray-400 mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
              </svg>
              <p class="text-gray-500 dark:text-gray-400">No files uploaded yet</p>
              <p class="text-sm text-gray-400 dark:text-gray-500 mt-1">
                Upload voice clones and video avatars to get started
              </p>
            </div>
          \`;
          return;
        }

        const filesHtml = filesData.map(file => {
          const icon = file.type === 'voice'
            ? \`<svg class="w-5 h-5 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z" /></svg>\`
            : \`<svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" /></svg>\`;

          return \`
            <div class="flex items-center justify-between p-4 border border-gray-200 dark:border-gray-700 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-700/50 transition-colors">
              <div class="flex items-center gap-3 flex-1 min-w-0">
                \${icon}
                <div class="flex-1 min-w-0">
                  <p class="font-medium truncate text-gray-900 dark:text-white">\${escapeHtml(file.name)}</p>
                  <p class="text-xs text-gray-500 dark:text-gray-400">
                    \${file.sizeMB} MB • Uploaded \${file.uploadedAt} • \${file.type === 'voice' ? 'Voice Clone' : 'Video Avatar'}
                  </p>
                </div>
              </div>

              <button
                onclick="handleDelete('\${file.id}', '\${file.type}')"
                class="ml-4 text-red-600 hover:text-red-800 dark:text-red-400 dark:hover:text-red-300 transition-colors p-2 hover:bg-red-50 dark:hover:bg-red-900/20 rounded flex-shrink-0"
                title="Delete file"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                </svg>
              </button>
            </div>
          \`;
        }).join('');

        container.innerHTML = \`<div class="space-y-2">\${filesHtml}</div>\`;
      }

      // Delete file
      async function handleDelete(fileId, fileType) {
        if (!confirm('Delete this file? This cannot be undone.')) return;

        try {
          const response = await fetch(\`/api/creator/files/\${fileId}?type=\${fileType}\`, {
            method: 'DELETE',
            credentials: 'include'
          });

          if (!response.ok) {
            const data = await response.json();
            throw new Error(data.error || 'Failed to delete file');
          }

          const data = await response.json();
          alert(\`File deleted. \${data.storageFreed}MB freed.\`);

          // Refresh
          await fetchFiles();
          await fetchStorageUsage();

        } catch (error) {
          console.error('Delete error:', error);
          alert(error.message || 'Failed to delete file');
        }
      }

      // Escape HTML
      function escapeHtml(text) {
        const div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
      }

      // Load on page load
      fetchStorageUsage();
      fetchFiles();
    </script>
`}) %>
