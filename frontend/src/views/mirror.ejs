<%- include('layout', { title: 'Identity Mirror' }) %>

<div class="min-h-screen bg-gray-50 dark:bg-gray-900 py-8 px-4">
  <div class="max-w-3xl mx-auto">
    <div class="bg-white dark:bg-gray-800 rounded-lg shadow-lg p-6 sm:p-8">
      <h1 class="text-2xl font-bold text-gray-900 dark:text-white mb-2">Identity Mirror</h1>
      <p class="text-gray-600 dark:text-gray-400 mb-6">
        Paste an incoming message and see how you would reply.
      </p>

      <form id="mirrorForm" class="mb-6">
        <div class="mb-4">
          <label for="context" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
            Context *
          </label>
          <select
            id="context"
            name="context"
            required
            class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg dark:bg-gray-700 dark:text-white focus:ring-2 focus:ring-blue-500"
          >
            <option value="linkedin_dm">LinkedIn DM</option>
            <option value="email">Email</option>
            <option value="sales">Sales</option>
            <option value="intro">Introduction</option>
            <option value="support">Support</option>
            <option value="personal">Personal</option>
          </select>
        </div>

        <div class="mb-4">
          <label for="incomingMessage" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
            Incoming Message *
          </label>
          <textarea
            id="incomingMessage"
            name="incomingMessage"
            required
            placeholder="Paste the message you received..."
            rows="4"
            class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg dark:bg-gray-700 dark:text-white focus:ring-2 focus:ring-blue-500"
          ></textarea>
        </div>

        <button
          type="submit"
          class="w-full bg-blue-600 text-white py-3 px-4 rounded-lg hover:bg-blue-700 transition-colors font-semibold"
        >
          Generate Reply
        </button>
      </form>

      <div id="result" class="hidden">
        <div class="border-t border-gray-200 dark:border-gray-700 pt-6">
          <h2 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">Suggested Reply</h2>
          
          <div class="bg-gray-50 dark:bg-gray-700 rounded-lg p-4 mb-4">
            <p id="reply-text" class="text-gray-900 dark:text-white whitespace-pre-wrap"></p>
          </div>

          <div id="rules-applied" class="mb-4 text-sm text-gray-600 dark:text-gray-400">
            <strong>Rules applied:</strong>
            <ul id="rules-list" class="list-disc list-inside mt-2"></ul>
          </div>

          <div class="flex gap-4">
            <button
              id="confirm-yes"
              class="flex-1 bg-green-600 text-white py-2 px-4 rounded-lg hover:bg-green-700 transition-colors font-semibold"
            >
              ✅ Yes, this sounds like me
            </button>
            <button
              id="regenerate-btn"
              class="flex-1 bg-gray-600 text-white py-2 px-4 rounded-lg hover:bg-gray-700 transition-colors font-semibold"
            >
              🔄 Regenerate
            </button>
          </div>
        </div>
      </div>

      <div id="error-message" class="mt-4 text-red-600 dark:text-red-400 hidden"></div>
    </div>
  </div>
</div>

<script>
  window.csrfToken = '<%= csrfToken %>';
  let currentMirrorRunId = null;

  document.getElementById('mirrorForm').addEventListener('submit', async (e) => {
    e.preventDefault();

    const context = document.getElementById('context').value;
    const incomingMessage = document.getElementById('incomingMessage').value;

    if (!incomingMessage.trim()) {
      return;
    }

    try {
      const response = await fetch('/api/identity/mirror', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': window.csrfToken,
        },
        credentials: 'include',
        body: JSON.stringify({ context, incomingMessage }),
      });

      const data = await response.json();

      if (!response.ok) {
        throw new Error(data.error || 'Failed to generate reply');
      }

      // Show result
      document.getElementById('reply-text').textContent = data.reply;
      
      const rulesList = document.getElementById('rules-list');
      rulesList.innerHTML = '';
      if (data.rulesApplied && data.rulesApplied.length > 0) {
        data.rulesApplied.forEach((rule: string) => {
          const li = document.createElement('li');
          li.textContent = rule;
          rulesList.appendChild(li);
        });
      } else {
        rulesList.innerHTML = '<li>No specific rules applied</li>';
      }

      currentMirrorRunId = data.mirrorRunId;
      document.getElementById('result').classList.remove('hidden');
      document.getElementById('error-message').classList.add('hidden');
    } catch (error: any) {
      const errorEl = document.getElementById('error-message');
      errorEl.textContent = error.message || 'Failed to generate reply';
      errorEl.classList.remove('hidden');
      document.getElementById('result').classList.add('hidden');
    }
  });

  document.getElementById('confirm-yes').addEventListener('click', async () => {
    if (!currentMirrorRunId) return;

    try {
      const response = await fetch('/api/identity/trust/confirm', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': window.csrfToken,
        },
        credentials: 'include',
        body: JSON.stringify({
          mirrorRunId: currentMirrorRunId,
          event: 'confirm_yes',
        }),
      });

      if (response.ok) {
        alert('✅ Confirmed! This helps improve your identity.');
      }
    } catch (error) {
      console.error('Failed to confirm:', error);
    }
  });

  document.getElementById('regenerate-btn').addEventListener('click', () => {
    document.getElementById('mirrorForm').dispatchEvent(new Event('submit'));
  });
</script>

